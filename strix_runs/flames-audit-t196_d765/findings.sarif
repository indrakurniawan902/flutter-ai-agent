                  "endLine": 5,
                  "snippet": {
                    "text": "/// Security tiers for tool execution within the agent loop.\n///\n/// Tier 1: Read-Only / Ambient (auto-execute).\n/// Tier 2: Sensitive / Permissioned (auto-execute only if runtime permission is granted).\n/// Tier 3: State-Modifying / Destructive (HITL confirmation required)."
                  }
