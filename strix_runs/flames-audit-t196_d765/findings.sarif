        },
        {
          "ruleId": "strix-coverage/deep-link-browsable-reachability-of-the-share-file-copy-sink",
          "ruleIndex": 128,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Deep-link (BROWSABLE) reachability of the share file-copy sink — Ruled out: MainActivity ACTION_VIEW content:// BROWSABLE filter (AndroidManifest.xml:109-115) reaching the vulnerable plugin branch\n\nRULED OUT as an independent path: the plugin's media branch (ReceiveSharingIntentPlugin.kt:86-89) requires intent.type != null; a browser ACTION_VIEW for content:// arrives with type null and falls through to the URL branch (:98-107), which only forwards intent.dataString as a URL and never calls FileDirectory. The exploitable entry is therefore ACTION_SEND / ACTION_SEND_MULTIPLE with a non-null type, which the manifest's text/*, image/* and */* filters accept (AndroidManifest.xml:78-108). Not filed as a separate finding; recorded as a narrowing of the attack surface, not a blocker."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "MainActivity ACTION_VIEW content:// BROWSABLE filter (AndroidManifest.xml:109-115) reaching the vulnerable plugin branch"
                }
