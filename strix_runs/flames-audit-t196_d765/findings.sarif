        {
          "ruleId": "strix-coverage/ssrf-redirect-based-host-escape-oversized-document-dos-on-skill-fetch",
          "ruleIndex": 64,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "SSRF / redirect-based host escape / oversized-document DoS on skill fetch — Ruled out: SkillRemoteLoader redirect policy (lib/data/datasources/remote/skills/skill_remote_loader.dart:52-134) + validateSourceUrl (lib/domain/services/skills/skill_remote_loader.dart:20-29)\n\nControl: same-host redirect enforcement at skill_remote_loader.dart:80-88 — `resolvedUri.host != currentHost` returns NetworkFailure and the next request is never issued (manual following with `followRedirects: false` at :64, so no post-hoc check is possible to bypass); fail-closed on missing Location (:75-79) and on >3 hops (:71-73). Size cap is enforced twice: declared Content-Length before touching the stream (:95-101) and a running byte count during streaming (:109-120). validateSourceUrl only enforces the transport shape (https + host) but the LAN-hop risk it declines to cover is closed by the same-host policy."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "SkillRemoteLoader redirect policy (lib/data/datasources/remote/skills/skill_remote_loader.dart:52-134) + validateSourceUrl (lib/domain/services/skills/skill_remote_loader.dart:20-29)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "SSRF / redirect-based host escape / oversized-document DoS on skill fetch",
