            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "lib/domain/tools/chat/url_reader_service.dart"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 58,
                        "endLine": 70
                      },
                      "insertedContent": {
                        "text": "/// Returns `null` when [url] is acceptable, else a short human message.\n  static String? validateUrl(String url) {\n    final trimmed = url.trim();\n    if (trimmed.isEmpty) return 'URL is empty';\n    final uri = Uri.tryParse(trimmed);\n    if (uri == null) return 'URL is missing a host';\n    final scheme = uri.scheme.toLowerCase();\n    if (scheme != 'http' && scheme != 'https') {\n      return 'Unsupported URL scheme: ${uri.scheme}';\n    }\n    if (uri.host.isEmpty) return 'URL is missing a host';\n    if (_isNonPublicHost(uri.host)) {\n      return 'Refusing to fetch a loopback, private, link-local, or '\n          'reserved address: ${uri.host}';\n    }\n    return null;\n  }\n\n  /// Whether [rawHost] names a loopback, private, link-local, or otherwise\n  /// non-public address that the reader must never fetch.\n  static bool _isNonPublicHost(String rawHost) {\n    var host = rawHost.toLowerCase();\n    while (host.endsWith('.')) {\n      host = host.substring(0, host.length - 1);\n    }\n    if (host.isEmpty) return true;\n    if (host == 'localhost' || host.endsWith('.localhost')) return true;\n    if (host.endsWith('.local') ||\n        host.endsWith('.internal') ||\n        host.endsWith('.home.arpa')) {\n      return true;\n    }\n\n    final octets = _ipv4Octets(host);\n    if (octets != null) return _isNonPublicIpv4(octets);\n\n    if (host.contains(':')) return _isNonPublicIpv6(host);\n\n    // Decimal, hexadecimal, and octal spellings of an IPv4 address.\n    if (RegExp(r'^(?:0[xX][0-9a-fA-F]+|[0-9]+)$').hasMatch(host)) return true;\n    return false;\n  }\n\n  static List<int>? _ipv4Octets(String host) {\n    final parts = host.split('.');\n    if (parts.length != 4) return null;\n    final octets = <int>[];\n    for (final part in parts) {\n      if (part.isEmpty || part.length > 3) return null;\n      if (!RegExp(r'^[0-9]+$').hasMatch(part)) return null;\n      final value = int.parse(part);\n      if (value > 255) return null;\n      octets.add(value);\n    }\n    return octets;\n  }\n\n  static bool _isNonPublicIpv4(List<int> octets) {\n    final first = octets[0];\n    final second = octets[1];\n    if (first == 0 || first == 10 || first == 127) return true;\n    if (first == 169 && second == 254) return true;\n    if (first == 172 && second >= 16 && second <= 31) return true;\n    if (first == 192 && second == 168) return true;\n    if (first == 100 && second >= 64 && second <= 127) return true;\n    if (first >= 224) return true;\n    return false;\n  }\n\n  static bool _isNonPublicIpv6(String host) {\n    if (host == '::' || host == '::1') return true;\n    if (host.startsWith('fe8') ||\n        host.startsWith('fe9') ||\n        host.startsWith('fea') ||\n        host.startsWith('feb')) {\n      return true;\n    }\n    if (host.startsWith('fc') || host.startsWith('fd')) return true;\n    if (host.startsWith('2002:') || host.startsWith('64:ff9b:')) return true;\n    if (host.startsWith('::ffff:')) {\n      final tail = host.substring('::ffff:'.length);\n      final octets = _ipv4Octets(tail);\n      if (octets != null) return _isNonPublicIpv4(octets);\n      final groups = tail.split(':');\n      if (groups.length == 2) {\n        final high = int.tryParse(groups[0].padLeft(4, '0'), radix: 16);\n        final low = int.tryParse(groups[1].padLeft(4, '0'), radix: 16);\n        if (high != null && low != null) {\n          return _isNonPublicIpv4([\n            (high >> 8) & 0xff,\n            high & 0xff,\n            (low >> 8) & 0xff,\n            low & 0xff,\n          ]);\n        }\n      }\n      return true;\n    }\n    return false;\n  }"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "lib/data/datasources/tools/chat/url_reader_service.dart"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 40,
                        "endLine": 69
                      },
                      "insertedContent": {
                        "text": "/// Maximum number of redirect hops [fetchUrl] will follow.\n  static const int _maxRedirects = 5;\n\n  /// Fetches [url] and returns the raw response body (HTML).\n  ///\n  /// Redirects are followed manually so that every hop is re-validated by\n  /// [UrlReaderServiceBase.validateUrl]. The HTTP client itself never follows\n  /// a redirect, which would otherwise let a public URL bounce the request to\n  /// a loopback, private, or link-local address.\n  Future<Either<Failure, String>> fetchUrl(String url) async {\n    var current = url;\n    try {\n      for (var hop = 0; hop <= _maxRedirects; hop++) {\n        final validationError = UrlReaderServiceBase.validateUrl(current);\n        if (validationError != null) {\n          return Left(ValidationFailure(validationError));\n        }\n\n        final response = await _dio.get<String>(\n          current,\n          options: Options(\n            responseType: ResponseType.plain,\n            followRedirects: false,\n            headers: const {\n              'User-Agent': _userAgent,\n              'Accept': _accept,\n              'Accept-Language': _acceptLanguage,\n            },\n          ),\n        );\n\n        final status = response.statusCode ?? 0;\n        if (status < 300 || status >= 400) {\n          final body = response.data;\n          if (body == null || body.trim().isEmpty) {\n            return Left(ParseFailure('No readable content found at $url'));\n          }\n          return Right(body);\n        }\n\n        final location = response.headers.value('location');\n        if (location == null || location.trim().isEmpty) {\n          return Left(ParseFailure('No readable content found at $url'));\n        }\n        current = Uri.parse(current).resolve(location.trim()).toString();\n      }\n      return Left(NetworkFailure('Too many redirects while fetching $url'));\n    } on DioException catch (e) {\n      return Left(NetworkFailure(_describeDioError(e, url)));\n    } catch (e) {\n      return Left(\n        NetworkFailure(\n          FailureMessage.humanize(e, context: 'Failed to fetch the page'),\n        ),\n      );\n    }\n  }"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "lib/domain/tools/chat/tool_registry.dart"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 1548,
                        "endLine": 1548
                      },
                      "insertedContent": {
                        "text": "securityTier: SecurityTier.tier3Hitl,"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "Enforce the destination policy in the reader itself, so that every caller — the ReAct loop, the gateway RPC receiver, and the share-intent prefetch — is covered by one control rather than by per-caller checks.\n\n1. Add a non-public-address policy to the URL validator: reject loopback, RFC1918, carrier-grade NAT, link-local, multicast, unspecified, and IPv6 unique-local and IPv4-mapped addresses, together with `localhost`, `.local`, `.internal`, `.home.arpa`, and trailing-dot variants, plus decimal, hexadecimal, and octal spellings of IPv4 addresses. Apply it after host lower-casing and dot-trimming so the comparison cannot be evaded by case or a trailing dot.\n2. Stop letting the HTTP client follow redirects. Follow them manually with a small hop limit and re-run the full validator on every hop, resolving each `Location` against the current URL before checking it. This closes the redirect-to-internal bypass and bounds redirect loops.\n3. Declare the tool as Tier 3 rather than Tier 2. A network fetch of an arbitrary destination is a state-changing egress action, and the current Tier-2 classification is only nominal because no runtime permission exists to check; routing it through the existing human-in-the-loop modal makes the destination visible to the user before the request is issued.\n4. Where a permission check is genuinely appropriate, treat a null `checkPermission` on a permissioned tool as a failure rather than a pass, so that a tier declaration cannot be silently neutralized by omitting the callback.\n5. Add regression tests covering the private-range, metadata, IPv4-mapped IPv6, alternative-notation, and redirect cases, alongside the existing scheme and empty-input tests.\n\nNote that restricting the tool to public destinations changes behaviour for users who legitimately point the agent at a LAN service; if that use case must be preserved, gate it behind an explicit opt-in allowlist rather than leaving the destination unrestricted.",
                "markdown": "Enforce the destination policy in the reader itself, so that every caller — the ReAct loop, the gateway RPC receiver, and the share-intent prefetch — is covered by one control rather than by per-caller checks.\n\n1. Add a non-public-address policy to the URL validator: reject loopback, RFC1918, carrier-grade NAT, link-local, multicast, unspecified, and IPv6 unique-local and IPv4-mapped addresses, together with `localhost`, `.local`, `.internal`, `.home.arpa`, and trailing-dot variants, plus decimal, hexadecimal, and octal spellings of IPv4 addresses. Apply it after host lower-casing and dot-trimming so the comparison cannot be evaded by case or a trailing dot.\n2. Stop letting the HTTP client follow redirects. Follow them manually with a small hop limit and re-run the full validator on every hop, resolving each `Location` against the current URL before checking it. This closes the redirect-to-internal bypass and bounds redirect loops.\n3. Declare the tool as Tier 3 rather than Tier 2. A network fetch of an arbitrary destination is a state-changing egress action, and the current Tier-2 classification is only nominal because no runtime permission exists to check; routing it through the existing human-in-the-loop modal makes the destination visible to the user before the request is issued.\n4. Where a permission check is genuinely appropriate, treat a null `checkPermission` on a permissioned tool as a failure rather than a pass, so that a tier declaration cannot be silently neutralized by omitting the callback.\n5. Add regression tests covering the private-range, metadata, IPv4-mapped IPv6, alternative-notation, and redirect cases, alongside the existing scheme and empty-input tests.\n\nNote that restricting the tool to public destinations changes behaviour for users who legitimately point the agent at a LAN service; if that use case must be preserved, gate it behind an explicit opt-in allowlist rather than leaving the destination unrestricted."
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "3b22bf31e3439fad4bc712110fdc29469ea095b8d19224eafe383db74cbc4ba9"
          },
          "properties": {
            "security-severity": "3.7",
            "strix_vuln_class_hash": "8e76cc1e2f109df99cd2de80962d67fea5f4a7eec1f197e83c21bce155a79ea6",
            "strix": {
              "id": "vuln-0013",
              "severity": "low",
              "cvss": 3.7,
              "timestamp": "2026-09-15 07:00:50 UTC",
              "target": "Flames Android application (`ai.hermes.flames`), repository under audit",
              "endpoint": "read_web_page (lib/domain/tools/chat/tool_registry.dart:1534)",
              "method": "AGENT-TOOL",
              "cwe": "CWE-918",
              "impact": "A party who can influence model input — by publishing a page the agent is asked to summarise, sending a notification the user has granted the app access to read, or controlling the configured model endpoint — can make the device issue HTTP(S) requests to addresses of their choosing and have the responses returned into the conversation, where they are forwarded to the configured LLM API.\n\nA party who can send frames on the paired gateway connection obtains a stronger version of the same primitive. The frame names the tool and carries the destination URL, no approval is requested, and the fetched body is written back to the sender over the same socket. That removes the model from the loop entirely: the attacker does not have to induce a tool call and does not depend on a third-party model endpoint to observe the result. The device is additionally told to advertise the capability — the tool manifest sent after a successful handshake lists `read_web_page` because the manifest provider applies an enablement filter and no pruning.\n\nThe concrete targets that become reachable from the device are the ones the threat model treats as internal: the on-device Hermes gateway and API server (`http://localhost:8642`, `http://127.0.0.1:8644/rpc`), any RFC1918 host on the user's LAN, and link-local cloud metadata services. The Hermes gateway is the component that holds the operator's LLM API key, so an SSRF that can read it is a credential-access primitive, not just a reachability bug. On the ReAct path, fetched content is additionally disclosed to whichever LLM provider the app is configured against, which is an unanticipated egress path for internal response bodies.\n\nThe demonstrated consequence is unauthorized outbound request capability and information flow, with the response returned to the caller on the gateway path. The specific contents readable from each internal service were not observed, so the confidentiality impact is assessed as limited rather than high.",
              "technical_analysis": "## 1. The tool is registered as permissioned but carries no permission check\n\n`lib/domain/tools/chat/tool_registry.dart:1531-1555` registers `read_web_page`:\n\n```dart\nsecurityTier: SecurityTier.tier2Permission,\nexecute: (args) async {\n  final url = args['url']?.toString() ?? '';\n  return service.fetchReadableText(url);\n},\n```\n\nThere is no `checkPermission` field. The `RegisteredTool` constructor makes it optional (`tool_registry.dart:53-60`), so the omission compiles silently.\n\n## 2. The single enforcement point short-circuits\n\n`lib/domain/tools/chat/tool_registry.dart:238-258` is the only gate:\n\n```dart\nif (SecurityPolicy.requiresPermission(tool.securityTier) &&\n    tool.checkPermission != null) {\n  final granted = await tool.checkPermission!();\n  if (!granted) {\n    return Left(PermissionFailure('Permission denied for tool: $name'));\n  }\n}\nreturn await tool.execute(arguments);\n```\n\n`requiresPermission` returns true for `tier2Permission`, but the `&&` requires a non-null callback. With `checkPermission == null` the entire block is skipped and execution falls straight through to `tool.execute(arguments)`. The declared tier therefore has no effect for this tool. Other Tier-2 tools in the same file do supply a checker (`tool_registry.dart:317`, `:783`, `:842`, `:872`, `:1109`, `:1366`, `:1705`), which shows the field is the intended mechanism and that its absence here is a defect rather than a design choice.\n\n## 3. The ReAct loop auto-executes everything that is not Tier 3\n\n`lib/presentation/screen/chat/cubit/agent_cubit.dart:752-769`:\n\n```dart\n// Tier 3: Pause loop and wait for HITL approval.\nif (registered.securityTier == SecurityTier.tier3Hitl) {\n  ...\n  emit(WaitingApproval(request));\n  return; // Execution pauses until approveAction or rejectAction\n}\n\n// Tier 1 & Tier 2: Auto-execute.\nemit(ExecutingTool(toolName, arguments: arguments));\nfinal execResult = await _toolRegistry.executeTool(toolName, arguments);\n```\n\nOnly `tier3Hitl` pauses. Because `read_web_page` is Tier 2 and its permission block is a no-op, the call executes with no confirmation and no permission evaluation. The URL comes straight from the model's tool-call arguments (`agent_cubit.dart:720-728` decodes `toolCall.argumentsFragment`; `tool_registry.dart:1550` reads `args['url']`).\n\n## 4. The URL validator imposes no host policy\n\n`lib/domain/tools/chat/url_reader_service.dart:58-70`:\n\n```dart\nstatic String? validateUrl(String url) {\n  final trimmed = url.trim();\n  if (trimmed.isEmpty) return 'URL is empty';\n  final uri = Uri.tryParse(trimmed);\n  if (uri == null) return 'URL is missing a host';\n  final scheme = uri.scheme.toLowerCase();\n  if (scheme != 'http' && scheme != 'https') {\n    return 'Unsupported URL scheme: ${uri.scheme}';\n  }\n  if (uri.host.isEmpty) return 'URL is missing a host';\n  return null;\n}\n```\n\nThe only checks are a non-empty string, a parseable URI, an `http`/`https` scheme, and a non-empty host. There is no loopback, RFC1918, link-local, or metadata-endpoint rejection, and no allowlist. The parameter's own description (`tool_registry.dart:1543`) advertises this: *\"Absolute http/https URL to read\"*.\n\nExecuting this exact function in a Dart 3.6 runtime returned `null` (accepted) for every internal target tested: `http://127.0.0.1:8644/rpc`, `http://localhost:8642/health`, `http://169.254.169.254/latest/meta-data/`, `http://10.0.2.2:8642/v1/models`, `http://192.168.1.100:8642/v1/models`, `http://172.16.5.5/admin`, `http://[::1]:8642/`, `http://[::ffff:127.0.0.1]/`, and the decimal/hex spellings `http://2130706433/` and `http://0x7f000001/`. Only non-HTTP schemes (`file:`, `gopher:`) are refused.\n\nA repository-wide search for any host or IP policy applied to this path — `isLoopback`, `isLinkLocal`, private-range checks, denylists, allowlists, or Dio interceptors — found none in `lib/`. The only allowlist in the tool layer is `SystemSettingsAllowList` for the unrelated `launch_system_setting` tool.\n\n## 5. Redirects are followed without revalidation\n\n`lib/data/datasources/tools/chat/url_reader_service.dart:40-54`:\n\n```dart\nfinal response = await _dio.get<String>(\n  url,\n  options: Options(\n    responseType: ResponseType.plain,\n    followRedirects: true,\n    ...\n```\n\n`validateUrl` runs exactly once, in `fetchReadableText` (`:72-76`), against the initial URL. `followRedirects: true` delegates hop-following to the HTTP client, which applies no host policy. An attacker-controlled public page returning `302 Location: http://127.0.0.1:8644/rpc` therefore defeats any initial-URL check. The repository's own tests cover only scheme rejection and empty input (`test/domain/tools/chat/url_reader_html_test.dart:45-59`); no test asserts a private-host policy, which is consistent with one never having been intended.\n\n## 6. Reachability of the tool itself\n\n`read_web_page` is enabled by default: `register` seeds `_toolEnabledStates` with `true` (`tool_registry.dart:208-211`), and `isToolEnabled` defaults to `true` for unknown names (`:222`). `syncWithToolRegistry` (`lib/domain/services/skills/skills_registry_service.dart:386-405`) only ever disables tools named by an *inactive* skill; `read_web_page` appears in no skill's `tools:` list, so it is never disabled. With progressive tool pruning enabled by default, the tool is not in the initial tool list (it appears in no `ToolSearchIndex` category), but the Tier-1 `tool_search` meta-tool ranks over all enabled tools (`tool_registry.dart:160-176`) and `tool_describe` returns any tool's full schema (`:180-205`); discovered names are re-added to the tool list on the next turn (`agent_cubit.dart:896-905`). The tool is thus reachable in two additional auto-executing steps.\n\n## 7. Exfiltration sink\n\nThe result string is appended as a tool message and sent to the remote LLM on the next iteration:\n\n```dart\n_messages.add(ChatMessage(\n  role: 'tool',\n  toolCallId: callId,\n  name: toolName,\n  content: resultStr,\n));\n```\n\n(`agent_cubit.dart:820-825`), serialized by `toWireJson()` (`lib/domain/entities/chat/chat_message.dart:116-127`) and passed to `streamCompletion(...)` at `agent_cubit.dart:906-930`. Fetched internal content therefore leaves the device in the next model request.\n\n## 8. On cleartext reachability\n\nThe engine revision this project pins (`.metadata` → `d3b14c876900e553bc736ca19295fc09e3853e8e`, engine `a804b261645ef8c13eb3d5c44a5c2fb0340c5539`) does not enforce the Android cleartext policy on `dart:io`. At that revision the Android embedder contains no `NetworkSecurityPolicy` or `isCleartextTrafficPermitted` reference at all, and `FlutterApplicationInfo.domainNetworkPolicy` is hard-coded to the empty string; the manifest-metadata plumbing that once carried a per-domain policy was removed upstream. The runtime hook that does exist, `_getHttpConnectionHookClosure`, permits a connection when the scheme is `https`, **or unconditionally when the host is loopback** — its own comment reads *\"Loopback connections are always allowed\"* — and otherwise permits cleartext because `may_insecurely_connect_to_all_domains` defaults to `true` and the Android embedder never passes `--disallow-insecure-connections`.\n\nThe consequence is that the loopback targets in this finding are reachable regardless of the cleartext question, and the remaining cleartext targets are reachable on this pinned revision. This claim rests on source inspection of the pinned engine revision rather than on a request issued from a device, and the builder's actual SDK revision may differ from the pinned one; the finding does not depend on it, because `https://` internal targets and loopback are reachable either way.\n\n## 9. Second trigger path: an inbound gateway RPC frame\n\nThe same tool is reachable with no model involvement, and on that path the response is delivered to the party that asked for it.\n\n- **Frame parsing.** `lib/domain/entities/gateway/gateway_message.dart:280-293` (`GatewayToolCallRequestMessage.fromJson`) takes `tool` and `arguments` verbatim from the wire; the dispatch cases that route `tool_call_request` and `tool_call` to it are at `:48-50`.\n- **Routing.** `lib/data/datasources/remote/gateway/gateway_client.dart:269-277` forwards the parsed frame to `_toolCallRequestController` whenever a listener is attached.\n- **Consumer.** `lib/presentation/screen/gateway/cubit/gateway_rpc_cubit.dart:85-91` subscribes to that stream, and `:127-139` calls the receiver with `onApprovalRequired: _requestHitlApproval`.\n- **Gate.** `lib/domain/services/gateway/gateway_rpc_receiver.dart:89` tests only `SecurityPolicy.requiresHitl(tool.securityTier)`. `read_web_page` is Tier 2 (`tool_registry.dart:1548`), so no approval is requested, and `:148-151` calls `toolRegistry.executeTool(request.tool, request.arguments)`.\n- **Result channel.** `gateway_rpc_receiver.dart:167-179` parses the tool's raw string result and sends it straight back with `sendToolCallResponse(callId: request.id, result: resultMap)`.\n\nThis path differs from the ReAct path in two ways that matter to exploitability. It does not depend on the model choosing to emit the call, and the fetched body is returned directly to the frame's sender rather than only being forwarded to the configured model endpoint.\n\nThe device is also told to advertise the capability. `getOpenAiToolDefinitions()` (`tool_registry.dart:233-236`) applies only the enablement filter and performs no pruning, and it is wired as the manifest provider at `lib/common/injection/modules.dart:39-40`; the manifest is sent after a successful handshake at `gateway_client.dart:247` and `:299-307`. `read_web_page` is enabled by default (`tool_registry.dart:208-211`, `:222`) and appears in no skill's tool list, so it is present in that manifest and the server is informed of it.\n\nThe listener is live whenever the chat screen is mounted: `GatewayRpcCubit` starts listening from its constructor (`gateway_rpc_cubit.dart:55`, `:67-69`), the factory that builds it does not override `autoStart` (`lib/common/injection/injection.config.dart:462-467`), and the screen resolves it during `initState` (`chat_screen.dart:201-202`). `GatewayClient` only drops the frame when no listener is attached (`gateway_client.dart:270-274`), which is not the state the application runs in.",
              "remediation_steps": "Enforce the destination policy in the reader itself, so that every caller — the ReAct loop, the gateway RPC receiver, and the share-intent prefetch — is covered by one control rather than by per-caller checks.\n\n1. Add a non-public-address policy to the URL validator: reject loopback, RFC1918, carrier-grade NAT, link-local, multicast, unspecified, and IPv6 unique-local and IPv4-mapped addresses, together with `localhost`, `.local`, `.internal`, `.home.arpa`, and trailing-dot variants, plus decimal, hexadecimal, and octal spellings of IPv4 addresses. Apply it after host lower-casing and dot-trimming so the comparison cannot be evaded by case or a trailing dot.\n2. Stop letting the HTTP client follow redirects. Follow them manually with a small hop limit and re-run the full validator on every hop, resolving each `Location` against the current URL before checking it. This closes the redirect-to-internal bypass and bounds redirect loops.\n3. Declare the tool as Tier 3 rather than Tier 2. A network fetch of an arbitrary destination is a state-changing egress action, and the current Tier-2 classification is only nominal because no runtime permission exists to check; routing it through the existing human-in-the-loop modal makes the destination visible to the user before the request is issued.\n4. Where a permission check is genuinely appropriate, treat a null `checkPermission` on a permissioned tool as a failure rather than a pass, so that a tier declaration cannot be silently neutralized by omitting the callback.\n5. Add regression tests covering the private-range, metadata, IPv4-mapped IPv6, alternative-notation, and redirect cases, alongside the existing scheme and empty-input tests.\n\nNote that restricting the tool to public destinations changes behaviour for users who legitimately point the agent at a LAN service; if that use case must be preserved, gate it behind an explicit opt-in allowlist rather than leaving the destination unrestricted.",
              "counterevidence": "The strongest argument against the ReAct framing is that it requires the model to choose an internal destination, which is an extra uncertain hop the attacker does not fully control. That argument does not apply to the gateway framing, where the tool name and the URL arrive in the same frame, which is why both paths are reported together. It also does not neutralise the ReAct path on its own, because the URL is model-supplied data with no host policy behind it and the tool is reachable through `tool_search`/`tool_describe` re-discovery.\n\nThe strongest argument against the gateway framing is that the gateway is treated as trusted infrastructure, so a malicious gateway operator is not the interesting case. This narrows but does not close the finding. The Tier 2 label is the device's own declared policy for capabilities that must not run on remote say-so, and this tool runs on remote say-so. The precondition is also reachable by an outside party rather than only by the legitimate operator: a hostile pairing payload makes the attacker's server the device's gateway, and on the pairing path the client then enters gateway mode and opens the socket without a destination confirmation step. That pairing weakness is tracked separately, and this finding does not depend on it — the point here is that once any server holds the device's gateway connection, the device's own tier policy does not stop a LAN read.\n\nA third argument is that Android 9 and later block cleartext traffic, so `http://169.254.169.254/` and `http://192.168.1.100/` would fail. This is only partly true and does not neutralize the finding. The engine revision this project pins does not apply the Android cleartext policy to `dart:io` — the Android embedder at that revision contains no `NetworkSecurityPolicy` or `isCleartextTrafficPermitted` reference, `FlutterApplicationInfo.domainNetworkPolicy` is hard-coded to an empty string, and the manifest-metadata plumbing that once carried a per-domain policy was removed upstream. More decisively, the runtime hook explicitly exempts loopback (*\"Loopback connections are always allowed\"*) and permits `https` unconditionally, so `http://127.0.0.1:8644/rpc`, `http://localhost:8642/health`, and `https://127.0.0.1:8642/` are reachable whether or not cleartext is restricted. That claim rests on source inspection of the pinned revision rather than a device request, and a builder using a different SDK revision could behave differently; the finding does not depend on it.\n\nA fourth argument is that the enabling Tier-2 gate defect is reported separately. The gate defect is the enabling condition; this finding is the specific, independently actionable consequence — an unrestricted-destination fetch with a redirect bypass and two distinct trigger paths — and it is closed by URL and redirect validation alone, without touching the gate.\n\nA fifth argument, considered and rejected, is that this is the same vulnerability as the model-output framing and should not be counted twice. It is one vulnerability with two reachability routes, and it is presented once, here, with both routes and one fix. The gateway route is included because it is materially stronger: it does not depend on model behaviour and it returns the body to the requester.\n\nChecked for and not found: any host, IP-range, or allowlist policy on the fetch path; any destination revalidation across redirects; any approval step on the gateway path for a non-Tier-3 tool; any runtime observation of an internal response body, which is why confidentiality is assessed as limited rather than high.",
              "confidence": "medium",
              "confidence_rationale": "The entire chain is a static trace on both trigger paths. No emulator, `adb`, or running application instance was available, so no request was issued from the application and no internal response body was observed, and neither the ReAct dispatch nor the gateway frame dispatch was exercised end to end. What was executed is the URL validator itself, copied verbatim into a Dart 3.6 runtime, which confirmed that every loopback, RFC1918, link-local, metadata, IPv4-mapped IPv6, and alternative-notation destination is accepted. The gateway path additionally rests on reading the frame dispatch and the RPC receiver rather than on observing a frame being executed. The specific contents readable from each internal service therefore remain unverified, which is why confidentiality is assessed as limited rather than high.",
              "severity_change_conditions": "A request issued from a running device that returns content from an internal-only service — for example a response body from the on-device Hermes gateway on `localhost:8642` or the Pocket Node RPC on `127.0.0.1:8644`, returned to the gateway frame's sender — would raise this to high by converting a demonstrated request capability into demonstrated internal-data access; conversely, evidence that the build environment enforces a destination policy that the pinned engine revision does not, or that the gateway connection cannot be obtained by a party other than the legitimate operator, would lower it.",
              "fix_verification": "**Gate 1 — Security closure.** Re-traced source to sink through the patched code. The sink is `Dio.get` in `fetchUrl`. After the patch, every `Dio.get` is preceded by `UrlReaderServiceBase.validateUrl(current)` on the same URL string, and `followRedirects` is `false`, so the client can no longer reach a host the validator has not seen. `_isNonPublicHost` rejects `127.0.0.1`, `localhost`, `169.254.169.254`, `10.0.2.2`, `192.168.1.100`, `172.16.5.5`, `[::1]`, `[::ffff:127.0.0.1]`, and the decimal/hex spellings, returning a message that `fetchUrl` converts to `Left(ValidationFailure(...))` before any socket is opened. The three callers — `fetchReadableText`, the gateway receiver, and the share-intent prefetch — all funnel through this single function, so the control is not caller-specific. A redirect to an internal address now resolves to a new `current`, loops, and is rejected by the same check on the next iteration.\n\n**Gate 2 — Bypass review.** Alternate input classes were tried against the proposed logic in an executed Dart runtime: 24 must-block inputs (loopback v4/v6, `localhost`, trailing-dot `localhost.`, uppercase `LOCALHOST`, RFC1918 in all three ranges, carrier-grade NAT, link-local v4/v6, unique-local `fd00::/8`, IPv4-mapped IPv6 in both dotted and hex-group form, unspecified `0.0.0.0`, multicast, decimal/hex/octal IPv4 spellings, `metadata.google.internal`, `foo.internal`, `printer.local`) and 6 must-allow inputs (public `https`, public `http`, `8.8.8.8`, `172.32.0.1` just outside the RFC1918 range, a public IPv6 address). Result: `block=24 allow=6 failures=0`. Sibling call sites of `validateUrl` were enumerated across `lib/` — `fetchReadableText` (data layer) and the share-intent prefetch in `chat_screen.dart:542` — and both are covered by the same function. The remaining equivalent sink on this path is the redirect hop, which is handled by Gate 1's manual loop.\n\n**Gate 3 — Preserved behavior.** A harness driving the patched `fetchUrl` against a stubbed HTTP client confirmed: a legitimate public fetch still returns its body; a legitimate redirect between two public hosts is still followed and returns the final body; an internal redirect is refused at the hop rather than at the initial URL; and a self-referential redirect loop terminates with `Too many redirects` instead of spinning. The repository's existing expectations in `test/domain/tools/chat/url_reader_html_test.dart:45-59` (`http://a.test` and `https://a.test/x` accepted, `ftp://` rejected with `Unsupported URL scheme`, whitespace rejected with `URL is empty`) were re-run against the patched validator with zero failures. No existing test asserts that a private or loopback host is fetchable, so no test regresses. Error semantics are preserved: validation still returns a `ValidationFailure` carrying a human-readable message, and the `DioException` and generic catch branches are unchanged.\n\n**Gate 4 — Repository checks.** No Dart toolchain matching this project's SDK was available in the analysis environment (the only SDK present is an unrelated ARM64 build without the project's dependency tree, and `dart pub get` cannot run offline), so `flutter analyze` and `flutter test` were **not** executed — this is an explicit gap. What was executed instead: the exact `validateUrl` body, the full helper set, and the full patched `fetchUrl` control flow were compiled and run in a Dart 3.6 runtime as standalone files, confirming they parse, type-check against stubbed `Either`/`Failure` shapes, and behave as described. `ValidationFailure` is already in scope in the data-layer file via the existing `tool_registry.dart` import at line 7, and `response.headers.value(...)` is available on the Dio response type already in use.\n\n**Narrowest-complete-change judgement.** The fix is two contiguous edits plus a one-line tier change, uses no new dependency, and enforces the invariant (\"the reader only ever connects to a public destination\") at the single point every caller already passes through. The Tier-3 change is included because a Tier-2 declaration with no permission callback is currently inert; raising the tier routes the call through the existing `WaitingApproval` modal, which displays the real arguments (`agent_cubit.dart:753-762`). A broader change to make a null `checkPermission` fail closed on all Tier-2 tools is noted in the remediation prose but deliberately not included here, because nine other tools intentionally omit the callback (documented at `tool_registry.dart:1761-1763`) and that change would break them.",
              "poc": {
                "description": "No emulator, `adb`, or running application was available, so the end-to-end request was not executed. The following is the reachability path established from source, with the validator behaviour confirmed by executing the exact function in a standalone Dart runtime.\n\n1. Confirm the tool is registered as permissioned with no permission check: `lib/domain/tools/chat/tool_registry.dart:1531-1555` declares `securityTier: SecurityTier.tier2Permission` and no `checkPermission`.\n2. Confirm the gate short-circuits: `lib/domain/tools/chat/tool_registry.dart:250-256` requires both `requiresPermission(tier)` and a non-null `checkPermission`; the null callback skips the block and control reaches `tool.execute(arguments)` at `:257`.\n3. Confirm nothing else gates it: `lib/presentation/screen/chat/cubit/agent_cubit.dart:753-769` pauses only for `tier3Hitl` and auto-executes Tier 1 and Tier 2.\n4. Confirm the validator accepts internal hosts: run the `validateUrl` body from `lib/domain/tools/chat/url_reader_service.dart:59-70` unmodified in a Dart runtime and pass each internal URL. All returned `null` (accepted): `http://127.0.0.1:8644/rpc`, `http://localhost:8642/health`, `http://169.254.169.254/latest/meta-data/`, `http://10.0.2.2:8642/v1/models`, `http://192.168.1.100:8642/v1/models`, `http://172.16.5.5/admin`, `http://[::1]:8642/`, `http://2130706433/`.\n5. Confirm redirects are not revalidated: `lib/data/datasources/tools/chat/url_reader_service.dart:41-54` sets `followRedirects: true`, while `validateUrl` is called only once on the initial URL in `fetchReadableText` at `:72-76`.\n6. Confirm the response is returned to the model: `agent_cubit.dart:820-825` appends the result as a `role: 'tool'` message, `chat_message.dart:116-127` serializes it, and `agent_cubit.dart:906-930` sends it to the remote LLM API.\n\nTo reproduce on a device, an operator would run the agent against a model whose output contains a tool call for `read_web_page` with an internal `url` argument (the equivalent of `{\"name\":\"read_web_page\",\"arguments\":\"{\\\"url\\\":\\\"http://127.0.0.1:8644/rpc\\\"}\"}`) and observe that the request is issued without any permission prompt or approval dialog.",
                "script_available": true
              }
            }
          }
