                      },
                      "insertedContent": {
                        "text": "/// Schemes [normalizeGatewayUri] can rewrite into a WebSocket URI.\n///\n/// TLS only: the gateway bearer token is sent over this connection, so a\n/// cleartext transport would expose the credential to the network.\nconst Set<String> acceptedGatewayUrlSchemes = {'https', 'wss'};"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "lib/domain/tools/pairing/pairing_parser.dart"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
