        {
          "ruleId": "strix-coverage/binder-surface-cross-app-access-to-captured-notification-data",
          "ruleIndex": 76,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Binder surface / cross-app access to captured notification data — Ruled out: FlamesNotificationListenerService — binder exposure and static state reachability\n\nFlamesNotificationListenerService is exported but gated by android:permission=\"android.permission.BIND_NOTIFICATION_LISTENER_SERVICE\" (AndroidManifest.xml:126), a signature-level system permission, so no third-party app can bind or start it. The class exposes no Binder interface: onBind returns the NotificationListenerService superclass behaviour and there is no additional public binder method. Its companion object state is private: notificationBuffer and instance are both private (FlamesNotificationListenerService.kt:19-20); only getRecentNotifications/clearBuffer/isConnected are public and those are called exclusively from MainActivity's in-process MethodChannel handler (MainActivity.kt:124-135), not over IPC. Cross-app reach would require the app's own UID or the system, so no third-party app can read the notification buffer."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "FlamesNotificationListenerService — binder exposure and static state reachability"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "Binder surface / cross-app access to captured notification data",
              "surface": "FlamesNotificationListenerService — binder exposure and static state reachability",
              "recorded_by": "Validate MainActivity Action Injection",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/cross-app-access-to-accessibility-tree-data-exported-settings-activity",
          "ruleIndex": 77,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Cross-app access to accessibility tree data / exported settings activity — Ruled out: FlamesAccessibilityService — window-content exposure and settingsActivity\n\nFlamesAccessibilityService is exported but gated by android:permission=\"android.permission.BIND_ACCESSIBILITY_SERVICE\" (AndroidManifest.xml:136), a signature-level system permission, so only the system can bind it. The config declares canRetrieveWindowContent=\"true\" (accessibility_service_config.xml:6) with flagRetrieveInteractiveWindows — that is inherent to the feature the user opts into, not an exposure to other apps, because AccessibilityService window content is readable only by the service itself. No android:settingsActivity is declared anywhere in android/ (grep = 0 hits), so there is no exported settings trampoline. Companion state is private: instance is private (FlamesAccessibilityService.kt:22); captureTree/isConnected/isEnabledInSettings are called only from MainActivity's in-process MethodChannel handler (MainActivity.kt:170-190). Another app cannot reach the captured screen tree."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "FlamesAccessibilityService — window-content exposure and settingsActivity"
                }
