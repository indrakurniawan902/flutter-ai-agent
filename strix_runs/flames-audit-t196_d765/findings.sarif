        {
          "ruleId": "strix-coverage/android-build-config-hygiene-affecting-credential-storage-allowbackup-cleartext-keystore-config",
          "ruleIndex": 50,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Android build/config hygiene affecting credential storage (allowBackup, cleartext, keystore config) — No issue identified: android/app/build.gradle.kts, AndroidManifest.xml, flutter_secure_storage 9.2.4 Android plugin defaults\n\nOnly dependency is flutter_secure_storage 9.2.4 (pubspec.lock:544-551). Its Android implementation encrypts values with AES-CBC-PKCS7 under a 16-byte key RSA-wrapped by an AndroidKeyStore key (StorageCipher18Implementation.java + RSACipher18Implementation.java, alias '<pkg>.FlutterSecureStoragePluginKey'), not with AndroidX EncryptedSharedPreferences, because AndroidOptions.encryptedSharedPreferences defaults to false and the app never passes AndroidOptions (modules.dart:23; secure_storage_service.dart:56-57). This is a hardening gap (no GCM integrity, legacy cipher), not a plaintext disclosure: the data key is keystore-wrapped. Android manifest sets no usesCleartextTraffic and no network_security_config."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "android/app/build.gradle.kts, AndroidManifest.xml, flutter_secure_storage 9.2.4 Android plugin defaults"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Android build/config hygiene affecting credential storage (allowBackup, cleartext, keystore config)",
              "surface": "android/app/build.gradle.kts, AndroidManifest.xml, flutter_secure_storage 9.2.4 Android plugin defaults",
              "recorded_by": "Secrets At Rest And In Logs",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/overlay-abuse-tapjacking-agent-state-exposure-via-the-floating-bubble",
          "ruleIndex": 51,
