            {
              "id": "strix-coverage/unauthorized-sensitive-data-collection-permission-bypass",
              "name": "Unauthorized sensitive-data collection / permission bypass",
              "shortDescription": {
                "text": "Coverage: Unauthorized sensitive-data collection / permission bypass"
              },
