{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter Analyze",
      "type": "shell",
      "command": "flutter",
      "args": [
        "analyze"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Flutter Test",
      "type": "shell",
      "command": "flutter",
      "args": [
        "test"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Build APK - Development",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--split-per-abi",
        "--flavor",
        "development",
        "-t",
        "lib/main_development.dart"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build APK - Production",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--split-per-abi",
        "--release",
        "--flavor",
        "production",
        "-t",
        "lib/main_production.dart"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build AppBundle - Production",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "appbundle",
        "--release",
        "--flavor",
        "production",
        "-t",
        "lib/main_production.dart"
      ],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}